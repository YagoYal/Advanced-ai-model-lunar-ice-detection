# Ambiente de execução — "production" ativa HTTPS redirect, HSTS e API key auth
ENV=production

# API Key de produção: protege SÓ o /predict (uso programático).
# Os endpoints do site (/analisar, /analisar_com_mapa, /simular, /ws/simular)
# são públicos e protegidos por rate limit por IP. NUNCA coloque esta key no
# frontend: qualquer VITE_* vai para o bundle público.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Origins permitidos no CORS (separados por vírgula, sem espaço)
ALLOWED_ORIGINS=https://seu-frontend.vercel.app

# Fonte de dados: "real" usa data/processed/lro/, "mock" usa data/processed/lro/mock/
DATA_MODE=real
